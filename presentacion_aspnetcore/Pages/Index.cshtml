@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">
        @ViewData["Error"]
    </div>
}

@if (!Model.EstaLogueado)
{
    <div class="login-wrapper">

        <div class="login-card">

            <img src="~/imagenes/logo.png"
                 class="login-logo" />

            <h1>Bienvenido</h1>

            <p class="login-subtitle">
                Inicia sesión en gestión ganadera  RC
            </p>

            <form method="POST">

                <div class="form-group">

                    <label>
                        Usuario
                    </label>

                    <input onchange="keyUp(this)"
                           asp-for="@Model.Correo"
                           class="form-control login-input" />

                </div>

                <div class="form-group">

                    <label>
                        Contraseña
                    </label>

                    <input type="password"
                           onchange="keyUp(this)"
                           asp-for="@Model.Contraseña"
                           class="form-control login-input" />

                </div>

                <div class="login-buttons">

                    <input type="submit"
                           value="Entrar"
                           asp-page-handler="BtEnter"
                           class="login-btn" />

                    <input type="submit"
                           value="Limpiar"
                           asp-page-handler="BtClean"
                           class="login-btn-secondary" />

                </div>

                <div class="registro-link">

                    <a asp-page="/ventanas/Registros">
                        ¿No eres usuario? Regístrate
                    </a>

                </div>

            </form>

        </div>

    </div>
}
