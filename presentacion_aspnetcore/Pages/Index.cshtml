@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">
        @ViewData["Error"]
    </div>
}

@if (!Model.EstaLogueado)
{
    <div class="login-wrapper">

        <div class="login-card">

            <img src="~/imagenes/logo.png"
                 class="login-logo" />

            <h1>Bienvenido</h1>

            <p class="login-subtitle">
                Inicia sesión en gestión ganadera  RC
            </p>

            <form method="POST">

                <div class="form-group">

                    <label>
                        Usuario
                    </label>

                    <input onchange="keyUp(this)"
                           asp-for="@Model.Correo"
                           class="form-control login-input" />

                </div>

                <div class="form-group">

                    <label>
                        Contraseña
                    </label>

                    <input type="password"
                           onchange="keyUp(this)"
                           asp-for="@Model.Contraseña"
                           class="form-control login-input" />

                </div>

                <div class="login-buttons">

                    <input type="submit"
                           value="Entrar"
                           asp-page-handler="BtEnter"
                           class="login-btn" />

                    <input type="submit"
                           value="Limpiar"
                           asp-page-handler="BtClean"
                           class="login-btn-secondary" />

                </div>

                <div class="registro-link">

                    <a asp-page="/ventanas/Registros">
                        ¿No eres usuario? Regístrate
                    </a>

                </div>

            </form>

        </div>

    </div>
}
else
{
    
        <div class="welcome-container">

            <div class="welcome-text">

                <h1>
                    Bienvenido a Ganadería RC
                </h1>

                <p class="welcome-subtitle">

                    Tu plataforma de gestión integral para el control,
                    seguimiento y crecimiento de tu proyecto ganadero.

                </p>

                <div class="welcome-description">

                    <p>
                        Desde aquí podrás administrar de manera eficiente:
                    </p>

                    <ul>
                        <li>
                            Gestión de fincas y entorno ganadero
                        </li>

                        <li>
                            Control de animales, lotes y estados
                        </li>

                        <li>
                            Alimentación, suplementación y producción
                        </li>

                        <li>
                            Gastos, compras, ventas y rentabilidad
                        </li>

                        <li>
                            Reportes PDF y seguimiento del clima
                        </li>
                    </ul>

                </div>

                <form method="POST">

                    <input type="submit"
                           value="Cerrar sesión"
                           asp-page-handler="BtClose"
                           class="btn-welcome-close" />

                </form>

            </div>

            <div class="welcome-image">

                <img src="~/imagenes/imagenBienvenida.jpg"
                     alt="Ganadería RC" />

            </div>

        </div>
}