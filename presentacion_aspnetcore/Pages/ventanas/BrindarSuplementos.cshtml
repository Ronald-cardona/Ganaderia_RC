@page
@model BrindarSuplementosModel
@{
    ViewData["Title"] = "BrindarSuplementos";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Brindar Suplementos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.BrindarSuplemento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.BrindarSuplemento == null)" />
            </div>

            @if (Model.BrindarSuplemento != null)
            {
                <input type="hidden"
                       asp-for="@Model.BrindarSuplemento!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha brindar suplemetos
                        </label>
                        <div class="col-6">
                            <input id="inFechaBrindarSuplemetos"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BrindarSuplemento!.FechaBrindarSuplemetos" />
                        </div>
                    </div>


                    @{
                        var animales = new presentacion_libreria.implementaciones.AnimalesNegocio().Consultar();
                    }

                    <div class="form-group">
                        <label>
                           Animales
                        </label>

                        <div class="col-6">

                            <select asp-for="BrindarSuplemento.IdAnimal"
                                    class="form-control">

                                <option value="">
                                    Seleccione un animal
                                </option>

                                @foreach (var animal in animales)
                                {
                                    <option value="@animal.Id">
                                        @animal.Codigo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>


                    @{
                        var suplementos = new presentacion_libreria.implementaciones.SuplementosNegocio().Consultar();
                    }

                    <div class="form-group">
                        <label>
                            Descripción de la venta  (Opcional)
                        </label>

                        <div class="col-6">

                            <select asp-for="BrindarSuplemento.SuplementoId"
                                    class="form-control">

                                <option value="">
                                    Seleccione una descripción
                                </option>

                                @foreach (var suplemento in suplementos)
                                {
                                    <option value="@suplemento.Id">
                                        @suplemento.Nombre
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                   

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.BrindarSuplemento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el BrindarSuplemento?
                            </h6>
                            <h6 align="left">
                                @Model.BrindarSuplemento!.FechaBrindarSuplemetos
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaBrindarSuplementos != null &&
                Model.ListaBrindarSuplementos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha brindar suplemetos
                        </th>
                        <th>
                            Código del animal
                        </th>
                        <th>
                            Nombre del suplemento
                        </th>
                       

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaBrindarSuplementos)
                    {
                        <tr>
                            <td>
                                @elemento.FechaBrindarSuplemetos.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @elemento._animal?.Codigo
                            </td>
                            <td>
                                @elemento._suplemento?.Nombre
                            </td>
                           

                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>
