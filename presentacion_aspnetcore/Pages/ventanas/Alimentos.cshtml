@page
@model AlimentosModel
@{
    ViewData["Title"] = "Alimentos";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Alimentos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Alimento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Alimento == null)" />
            </div>

            @if (Model.Alimento != null)
            {
                <input type="hidden"
                       asp-for="@Model.Alimento!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Tipo de alimento
                        </label>
                        <div class="col-6">
                            <input id="inTipoAlimento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Alimento!.TipoAlimento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo del alimento
                        </label>
                        <div class="col-6">
                            <input id="inCostoAlimento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Alimento!.CostoAlimento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Cantidad del alimento
                        </label>
                        <div class="col-6">
                            <input id="inCantidadAlimento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Alimento!.CantidadAlimento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha de Compra del alimento
                        </label>
                        <div class="col-6">
                            <input id="inFechaCompraAlimento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Alimento!.FechaCompraAlimento" />
                        </div>
                    </div>
                  

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Alimento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Alimento?
                            </h6>
                            <h6 align="left">
                                @Model.Alimento!.TipoAlimento
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaAlimentos != null &&
                Model.ListaAlimentos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Tipo de alimento
                        </th>
                        <th>
                            Costo del alimento
                        </th>
                        <th>
                            Cantidad del alimento
                        </th>
                         <th class="cl_hidden">
                            FechaCompraAlimento
                        </th> 
                       

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaAlimentos)
                    {
                        <tr>
                            <td>
                                @elemento.TipoAlimento
                            </td>
                            <td>
                                @elemento.CostoAlimento
                            </td>
                            <td>
                                @elemento.CantidadAlimento
                            </td>
                             <td class="cl_hidden">
                                @elemento.FechaCompraAlimento.ToString("dd/MM/yyyy")
                            </td> 
                            

                            <td>
                                <div class="acciones">
                                    <button type="submit"
                                            asp-page-handler="BtModificar"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Modificar">

                                        <img src="~/imagenes/editable.png"
                                             class="action-icon" />
                                    </button>


                                    <button type="submit"
                                            asp-page-handler="BtBorrarVal"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Borrar">

                                        <img src="~/imagenes/delete.png"
                                             class="action-icon" />
                                    </button>
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>
