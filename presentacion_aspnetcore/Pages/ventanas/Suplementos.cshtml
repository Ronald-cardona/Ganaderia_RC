@page
@model SuplementosModel
@{
    ViewData["Title"] = "Suplementos";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Suplementos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Suplemento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Suplemento == null)" />
            </div>

            @if (Model.Suplemento != null)
            {
                <input type="hidden"
                       asp-for="@Model.Suplemento!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Suplemento!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo del suplemento
                        </label>
                        <div class="col-6">
                            <input id="inCostoSuplemento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Suplemento!.CostoSuplemento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Cantidad de suplemento (kg)
                        </label>
                        <div class="col-6">
                            <input id="inCantidadSuplemento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Suplemento!.CantidadSuplemento" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha Compra suplemento
                        </label>
                        <div class="col-6">
                            <input id="inFechaCompraSuplemento"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Suplemento!.FechaCompraSuplemento" />
                        </div>
                    </div>
                    

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Suplemento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Suplemento?
                            </h6>
                            <h6 align="left">
                                @Model.Suplemento!.Nombre
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaSuplementos != null &&
                Model.ListaSuplementos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Costo del suplemento
                        </th>
                        <th>
                            Cantidad de Suplemento (kg)
                        </th>
                         <th class="cl_hidden">
                            FechaCompraSuplemento
                        </th> 
                       

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaSuplementos)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                $@elemento.CostoSuplemento.ToString("N0")
                            </td>
                            <td>
                                @elemento.CantidadSuplemento.ToString("N2") kg
                            </td>
                            <td class="cl_hidden">
                                @elemento.FechaCompraSuplemento.ToString("dd/MM/yyyy")
                            </td>
                           

                            <td>
                                <div class="acciones">
                                    <button type="submit"
                                            asp-page-handler="BtModificar"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Modificar">

                                        <img src="~/imagenes/editable.png"
                                             class="action-icon" />
                                    </button>


                                    <button type="submit"
                                            asp-page-handler="BtBorrarVal"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Borrar">

                                        <img src="~/imagenes/delete.png"
                                             class="action-icon" />
                                    </button>
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>