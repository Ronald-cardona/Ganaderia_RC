@page
@model VisitasVeterinariasModel
@{
    ViewData["Title"] = "VisitasVeterinarias";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Visitas Veterinarias</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.VisitasVeterinaria != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.VisitasVeterinaria == null)" />
            </div>

            @if (Model.VisitasVeterinaria != null)
            {
                <input type="hidden"
                       asp-for="@Model.VisitasVeterinaria!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha de la visita
                        </label>
                        <div class="col-6">
                            <input id="inFechaVisita"
                                   class="cts_forms form-control"
                                   asp-for="@Model.VisitasVeterinaria!.FechaVisita" />
                        </div>
                    </div>


                    @{
                        var correo = HttpContext.Session.GetString("Usuario");
                        var animales = new presentacion_libreria.implementaciones.AnimalesNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Código del animal 
                        </label>

                        <div class="col-6">

                            <select asp-for="VisitasVeterinaria.IdAnimal"
                                    class="form-control">

                                <option value="">
                                    Seleccione el codigo del animal 
                                </option>

                                @foreach (var animal in animales)
                                {
                                    <option value="@animal.Id">
                                        @animal.Codigo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>


                    @{
                        
                        var personas = new presentacion_libreria.implementaciones.PersonasNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Nombre del veterinario
                        </label>

                        <div class="col-6">

                            <select asp-for="VisitasVeterinaria.VeterinarioId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un veterinario
                                </option>

                                @foreach (var persona in personas)
                                {
                                    <option value="@persona.Id">
                                        @persona.Nombre
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                    

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.VisitasVeterinaria != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el VisitasVeterinaria?
                            </h6>
                            <h6 align="left">
                                @Model.VisitasVeterinaria!.FechaVisita
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaVisitasVeterinarias != null &&
                Model.ListaVisitasVeterinarias.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            FechaVisita
                        </th>
                        <th>
                            Animal visitado
                        </th>
                        <th>
                          Nombre del veterinario
                        </th>
                       

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaVisitasVeterinarias)
                    {
                        <tr>
                            <td>
                                @elemento.FechaVisita.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @elemento._animal?.Codigo

                            </td>
                            <td>
                                @elemento._persona?.Nombre
                            </td>
                            

                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>