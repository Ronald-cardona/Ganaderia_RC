@page
@model BrindarAlimentosModel
@{
    ViewData["Title"] = "BrindarAlimentos";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Brindar Alimentos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.BrindarAlimento != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.BrindarAlimento == null)" />
            </div>

            @if (Model.BrindarAlimento != null)
            {
                <input type="hidden"
                       asp-for="@Model.BrindarAlimento!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha Brindar Alimentos
                        </label>
                        <div class="col-6">
                            <input id="inFechaBrindarAlimentos"
                                   class="cts_forms form-control"
                                   asp-for="@Model.BrindarAlimento!.FechaBrindarAlimentos" />
                        </div>
                    </div>

                    @{
                        var correo = HttpContext.Session.GetString("Usuario");
                        var animales = new presentacion_libreria.implementaciones.AnimalesNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Animal que recibe el alimento
                        </label>

                        <div class="col-6">

                            <select asp-for="BrindarAlimento.IdAnimal"
                                    class="form-control">

                                <option value="">
                                    Seleccione un animal
                                </option>

                                @foreach (var animal in animales)
                                {
                                    <option value="@animal.Id">
                                        @animal.Codigo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>


                    @{
                        var alimentos = new presentacion_libreria.implementaciones.AlimentosNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Alimentos
                        </label>

                        <div class="col-6">

                            <select asp-for="BrindarAlimento.AlimentoId"
                                    class="form-control">

                                <option value="">
                                    Seleccione el alimento
                                </option>

                                @foreach (var alimento in alimentos)
                                {
                                    <option value="@alimento.Id">
                                        @alimento.TipoAlimento
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                   

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.BrindarAlimento != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el BrindarAlimento?
                            </h6>
                            <h6 align="left">
                                @Model.BrindarAlimento!.FechaBrindarAlimentos
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaBrindarAlimentos != null &&
                Model.ListaBrindarAlimentos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha brindar alimentos
                        </th>
                        <th>
                            Alimento
                        </th>
                        <th>
                            Animal alimentado
                        </th>
                        
                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaBrindarAlimentos)
                    {
                        <tr>
                            <td>
                                @elemento.FechaBrindarAlimentos.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @elemento._alimento?.TipoAlimento
                            </td>
                            <td>
                                @elemento._animal?.Codigo
                            </td>
                            

                            <td>
                                <input type="submit"
                                       value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>
