@page
@model GastosModel
@{
    ViewData["Title"] = "Gastos";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Gastos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Gasto != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Gasto == null)" />
            </div>

            @if (Model.Gasto != null)
            {
                <input type="hidden"
                       asp-for="@Model.Gasto!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha del gasto
                        </label>
                        <div class="col-6">
                            <input id="inFechaGasto"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Gasto!.FechaGasto" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo del Gastol
                        </label>
                        <div class="col-6">
                            <input id="inCostoGasto"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Gasto!.CostoGasto" />
                        </div>
                    </div>



                    <div class="form-group">
                        <label>
                            Descripción del gasto
                        </label>
                        <div class="col-6">
                            <input id="inDescripcionGasto"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Gasto!.DescripcionGasto" />
                        </div>
                    </div>


                    @{
                        var correo = HttpContext.Session.GetString("Usuario");
                        var compras = new presentacion_libreria.implementaciones.ComprasNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Nombre del proveedor 
                        </label>

                        <div class="col-6">

                            <select asp-for="Gasto.CompraId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un proveedor
                                </option>

                                @foreach (var compra in compras)
                                {
                                    <option value="@compra.Id">
                                        @compra.DescripcionCompra
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                    
                    @{
                       
                        var alimentos = new presentacion_libreria.implementaciones.AlimentosNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Nombre del alimento
                        </label>

                        <div class="col-6">

                            <select asp-for="Gasto.AlimentoId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un alimento
                                </option>

                                @foreach (var alimento in alimentos)
                                {
                                    <option value="@alimento.Id">
                                        @alimento.TipoAlimento
                                    </option>
                                }

                            </select>

                        </div>
                    </div>

                    @{
                       
                        var vacunas = new presentacion_libreria.implementaciones.VacunasNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Nombre de la vacuna
                        </label>

                        <div class="col-6">

                            <select asp-for="Gasto.VacunaId"
                                    class="form-control">

                                <option value="">
                                    Seleccione una vacuna
                                </option>

                                @foreach (var vacuna in vacunas)
                                {
                                    <option value="@vacuna.Id">
                                        @vacuna.Nombre
                                    </option>
                                }

                            </select>

                        </div>
                    </div>


                    @{
                        var suplementos = new presentacion_libreria.implementaciones.SuplementosNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Nombre del suplemento
                        </label>

                        <div class="col-6">

                            <select asp-for="Gasto.SuplementoId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un suplemento
                                </option>

                                @foreach (var suplemento in suplementos)
                                {
                                    <option value="@suplemento.Id">
                                        @suplemento.Nombre
                                    </option>
                                }

                            </select>

                        </div>
                    </div>


                    @{
                        
                        var personas = new presentacion_libreria.implementaciones.PersonasNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Seleccione un nombre
                        </label>

                        <div class="col-6">

                            <select asp-for="Gasto.PersonaId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un nombre
                                </option>

                                @foreach (var persona in personas)
                                {
                                    <option value="@persona.Id">
                                        @persona.Nombre
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                   

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Gasto != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Gasto?
                            </h6>
                            <h6 align="left">
                                @Model.Gasto!.FechaGasto
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaGastos != null &&
                Model.ListaGastos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha del gasto
                        </th>
                        <th>
                            Costo del gasto
                        </th>
                        <th>
                            Descripción del gasto
                        </th>
                        
                        <th class="cl_hidden">
                           detalle de la compra
                        </th>
                        <th class="cl_hidden">
                            Nombre del alimento
                        </th>
                        <th class="cl_hidden">
                            Nombre de la Vacuna
                        </th>
                        <th class="cl_hidden">
                           Nombre del  Suplemento
                        </th>
                        <th class="cl_hidden">
                            Pago de nómina
                        </th>
                        

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaGastos)
                    {
                        <tr>
                            <td>
                                @elemento.FechaGasto.ToString("dd/MM/yyyy")
                            </td>
                            <td class="cl_hidden">
                               
                                $  @elemento.CostoGasto.ToString("N0")
                            </td>

                            <td>
                                @elemento.DescripcionGasto
                            </td>
                            
                            <td class="cl_hidden">
                                @elemento._compra?.DescripcionCompra
                            </td>
                            <td class="cl_hidden">
                                @elemento._alimento?.TipoAlimento
                            </td>
                            <td class="cl_hidden">
                                @elemento._vacuna?.Nombre
                            </td>
                            <td class="cl_hidden">
                                @elemento._suplemento?.Nombre
                            </td>
                            <td class="cl_hidden">
                                @elemento._persona?.Nombre
                            </td>
                            

                            <td>
                                <div class="acciones">
                                    <button type="submit"
                                            asp-page-handler="BtModificar"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Modificar">

                                        <img src="~/imagenes/editable.png"
                                             class="action-icon" />
                                    </button>


                                    <button type="submit"
                                            asp-page-handler="BtBorrarVal"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Borrar">

                                        <img src="~/imagenes/delete.png"
                                             class="action-icon" />
                                    </button>
                            </td>
                        </tr>

                       

                        
                    }

                    @{
                        decimal totalGastos = Model.ListaGastos.Sum(x => x.CostoGasto);
                           
                    }

                    <tfoot>
                        <tr style="background-color:#f2f2f2;
                             font-weight:bold;">

                            <td class ="cl_hidden">
                                
                                 Total Gastos:
                           </td>

                             <td>
                                 $@totalGastos.ToString("N0")
                           </td>

                           <td colspan="7"></td>
                       </tr>
                    </tfoot>

                    
                   
                        

                    
                </table>
            }
        </form>
    </div>
</center>