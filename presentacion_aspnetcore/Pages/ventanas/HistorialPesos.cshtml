@page
@model HistorialPesosModel
@{
    ViewData["Title"] = "HistorialPesos";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Historial de pesos</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.HistorialPeso != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.HistorialPeso == null)" />
            </div>

            @if (Model.HistorialPeso != null)
            {
                <input type="hidden"
                       asp-for="@Model.HistorialPeso!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                             Fecha del último pesaje
                        </label>
                        <div class="col-6">
                            <input id="inFechaUltimoPesaje"
                                   class="cts_forms form-control"
                                   asp-for="@Model.HistorialPeso!.FechaUltimoPesaje" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha del pesaje actual
                        </label>
                        <div class="col-6">
                            <input id="inFechaPesajeActual"
                                   class="cts_forms form-control"
                                   asp-for="@Model.HistorialPeso!.FechaPesajeActual" />
                        </div>
                    </div>

                    @{
                        var correo = HttpContext.Session.GetString("Usuario");
                        var animal = new presentacion_libreria.implementaciones.AnimalesNegocio()
                        .Consultar(correo!).FirstOrDefault(x => x.Id == Model.HistorialPeso!.IdAnimal);
                                   
                    }
                    
                    <div class="form-group">
                        <label>
                            Último peso
                        </label>
                        <div class="col-6">
                            <input id="inPesoActual"
                                   class="cts_forms form-control"
                                   asp-for="@Model.HistorialPeso!.UltimoPeso" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Peso actual
                        </label>
                        <div class="col-6">
                            <input id="inPesoActual"
                                   class="cts_forms form-control"
                                   asp-for="@Model.HistorialPeso!.PesoActual" />
                        </div>
                    </div>

                    @{
                        var correo1 = HttpContext.Session.GetString("Usuario");
                        var animales = new presentacion_libreria.implementaciones.AnimalesNegocio().Consultar(correo1!);
                    }

                    <div class="form-group">
                        <label>
                            Código del animal
                        </label>

                        <div class="col-6">

                            <select asp-for="HistorialPeso.IdAnimal"
                                    class="form-control">

                                <option value="">
                                    Seleccione el codigo del animal
                                </option>

                                @foreach (var animal in animales)
                                {
                                    <option value="@animal.Id">
                                        @animal.Codigo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                   

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.HistorialPeso != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el HistorialPeso?
                            </h6>
                            <h6 align="left">
                                @Model.HistorialPeso!.FechaPesajeActual
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaHistorialPesos != null &&
                Model.ListaHistorialPesos.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>

                        <th class="cl_hidden">
                            Código del  animal
                        </th>

                        <th>
                            Peso inicial del animal
                        </th>

                        <th>
                            Fecha último Pesaje
                        </th>

                        <th>
                            Ultimo peso
                        </th>

                        <th>
                            Fecha pesaje actual
                        </th>
                       
                       
                        <th class="cl_hidden">
                            Peso actual
                        </th>

                        <th class="cl_hidden">
                            Ganancia de peso 
                        </th>


                        <th class="cl_hidden">
                            Ganancia diaria de peso
                        </th>

                        <th class="cl_hidden">
                            Dias 
                        </th>
               

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaHistorialPesos)
                    {
                        <tr>
                           
                            <td class="cl_hidden">
                                @elemento._animal?.Codigo
                            </td>

                            <td class="cl_hidden">
                                @elemento._animal?.PesoInicial kg
                            </td>

                             <td class="cl_hidden">
                                @elemento.FechaUltimoPesaje.ToString("dd/MM/yyyy")
                            </td> 

                            <td class="cl_hidden">
                                @elemento.UltimoPeso kg
                            </td>

                            <td class="cl_hidden">
                                @elemento.FechaPesajeActual.ToString("dd/MM/yyyy")
                            </td>
                           
                           
                            <td class="cl_hidden">
                                @elemento.PesoActual kg
                            </td>

                            
                            <td class="cl_hidden">
                                @elemento.GananciaPeso?.ToString("N2") kg
                            </td>

                            
                            <td class="cl_hidden">
                                @elemento.GananciaDiaria?.ToString("N2") kg/día
                            </td>

                            
                            <td class="cl_hidden">
                                @elemento.DiasTranscurridos
                            </td>


                            

                           

                            <td>
                                 <div class="acciones">
                                <button type="submit"
                                        asp-page-handler="BtModificar"
                                        asp-route-data="@elemento.Id"
                                        class="icon-btn edit-btn"
                                        title="Modificar">

                                    <img src="~/imagenes/editable.png"
                                         class="action-icon" />
                                </button>

                                <button type="submit"
                                        asp-page-handler="BtBorrarVal"
                                        asp-route-data="@elemento.Id"
                                        class="icon-btn edit-btn"
                                        title="Borrar">

                                    <img src="~/imagenes/delete.png"
                                         class="action-icon" />
                                </button>


                                <button type="submit"
                                        asp-page-handler="ReportePdf"
                                        asp-route-IdAnimal="@elemento.IdAnimal"
                                        class="icon-btn pdf-btn"
                                        title="Generar reporte PDF">

                                    <img src="~/imagenes/pdf.png"
                                         class="action-icon" />

                                </button>
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>