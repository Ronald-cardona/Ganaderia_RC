@page
@model LotesModel
@{
    ViewData["Title"] = "Lotes";
}


<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Lotes</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Lote != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Lote == null)" />
            </div>

            @if (Model.Lote != null)
            {
                <input type="hidden"
                       asp-for="@Model.Lote!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Código
                        </label>
                        <div class="col-6">
                            <input id="inCodigo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Lote!.Codigo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Fecha de creacion del lote
                        </label>
                        <div class="col-6">
                            <input id="inFechaCreacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Lote!.FechaCreacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Cantidad de animales
                        </label>
                        <div class="col-6">
                            <input id="inCantidadAnimales"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Lote!.CantidadAnimales" />
                        </div>
                    </div>
                   

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Lote != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Lote?
                            </h6>
                            <h6 align="left">
                                @Model.Lote!.Codigo
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaLotes != null &&
                Model.ListaLotes.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Código
                        </th>
                        <th>
                            Fecha de creacion
                        </th>
                        <th>
                            Cantidad de animales
                        </th>
                       
                       

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaLotes)
                    {
                        <tr>
                            <td>
                                @elemento.Codigo
                            </td>
                            <td>
                                @elemento.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @elemento.CantidadAnimales
                            </td>

                           
                           

                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>
