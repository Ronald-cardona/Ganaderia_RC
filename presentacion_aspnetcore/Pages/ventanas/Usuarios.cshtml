@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}



<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
             
            @Html.AntiForgeryToken()
           

            <div align="left">
                <h3>Usuarios</h3>
            </div>

            <div>
                
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Usuario != null)" />
                    
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Usuario == null)" />
            </div>

            @if (Model.Usuario != null)
            {
                <input type="hidden"
                       asp-for="@Model.Usuario!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Correo
                        </label>
                        <div class="col-6">
                            <input id="inCorreo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Usuario!.Correo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Contraseña
                        </label>
                        <div class="col-6">
                            <input id="inCostoUsuario"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Usuario!.Contraseña" />
                        </div>
                    </div>





                    @{
                    var roles = new presentacion_libreria.implementaciones.RolesNegocio().Consultar();
                    }
                    
                 
                    <div class="form-group">
                        <label>
                            Rol  del usuario
                        </label>

                        <div class="col-6">

                            <select asp-for="Usuario.RolId"
                                    class="form-control">

                                <option value="">
                                    Seleccione el rol
                                </option>

                                @foreach (var rol in roles)
                                {
                                    <option value="@rol.Id">
                                        @rol.Tipo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>
                   
                  

                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Usuario != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Usuario?
                            </h6>
                            <h6 align="left">
                                @Model.Usuario!.Correo
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaUsuarios != null &&
                Model.ListaUsuarios.Count > 0  )
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Correo
                        </th>
                        <th>
                            Contraseña
                        </th>

                        <th>
                            Rol del usuario
                        </th>
                       

                       
                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaUsuarios)
                    {
                        <tr>
                            <td>
                                @elemento.Correo
                            </td>
                            <td>
                                @elemento.Contraseña
                            </td>

                            <td>
                                @elemento._rol?.Tipo
                            </td>
                           

                           
                                    <td>
                                        <div class="acciones">
                                            <button type="submit"
                                                    asp-page-handler="BtModificar"
                                                    asp-route-data="@elemento.Id"
                                                    class="icon-btn edit-btn"
                                                    title="Modificar">

                                                <img src="~/imagenes/editable.png"
                                                     class="action-icon" />
                                            </button>


                                            <button type="submit"
                                                    asp-page-handler="BtBorrarVal"
                                                    asp-route-data="@elemento.Id"
                                                    class="icon-btn edit-btn"
                                                    title="Borrar">

                                                <img src="~/imagenes/delete.png"
                                                     class="action-icon" />
                                            </button>
                                    </td>
                                
                            </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>

