@page
@model AplicacionVacunasModel
@{
    ViewData["Title"] = "AplicacionVacunas";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Aplicacion Vacunas</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.AplicacionVacuna != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.AplicacionVacuna == null)" />
            </div>

            @if (Model.AplicacionVacuna != null)
            {
                <input type="hidden"
                       asp-for="@Model.AplicacionVacuna!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Fecha de aplicación
                        </label>
                        <div class="col-6">
                            <input id="inFechaAplicacion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.AplicacionVacuna!.FechaAplicacion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Id del animal
                        </label>
                        <div class="col-6">
                            <input id="inIdAnimal"
                                   class="cts_forms form-control"
                                   asp-for="@Model.AplicacionVacuna!.IdAnimal" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Id de la vacuna
                        </label>
                        <div class="col-6">
                            <input id="inVacunaId"
                                   class="cts_forms form-control"
                                   asp-for="@Model.AplicacionVacuna!.VacunaId" />
                        </div>
                    </div>
                    

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.AplicacionVacuna != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el AplicacionVacuna?
                            </h6>
                            <h6 align="left">
                                @Model.AplicacionVacuna!.FechaAplicacion
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaAplicacionVacunas != null &&
                Model.ListaAplicacionVacunas.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Fecha de aplicación
                        </th>
                        <th>
                            Id del animal
                        </th>
                        <th>
                            Id de la vacuna
                        <th class="cl_actions">
                                Acción
                        </th>
                        
                    </tr>
                    @foreach (var elemento in Model.ListaAplicacionVacunas)
                    {
                        <tr>
                            <td>
                                    @elemento.FechaAplicacion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                    @elemento.IdAnimal
                            </td>
                            <td>
                                    @elemento.VacunaId
                            </td>
                            

                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>

