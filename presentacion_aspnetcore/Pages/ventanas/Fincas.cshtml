@page
@model FincasModel
@{
    ViewData["Title"] = "Fincas";
}
@if (Model.ClimaActual != null)
{
    <div class="weather-card">

        <h3>
            🌤 Clima actual de mi finca
        </h3>

        <div class="weather-grid">

            <div class="weather-item">
                <span>🌡 Temperatura</span>
                <strong>
                    @Model.ClimaActual.Temperatura °C
                </strong>
            </div>

            <div class="weather-item">
                <span>💧 Humedad</span>
                <strong>
                    @Model.ClimaActual.Humedad %
                </strong>
            </div>

            <div class="weather-item">
                <span>🌧 Lluvia</span>
                <strong>
                    @Model.ClimaActual.Lluvia mm
                </strong>
            </div>

            <div class="weather-item">
                <span>🌬 Viento</span>
                <strong>
                    @Model.ClimaActual.VelocidadViento km/h
                </strong>
            </div>

        </div>
    </div>
}
<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Fincas</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Finca != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Finca == null)" />
            </div>

            @if (Model.Finca != null)
            {
                <input type="hidden"
                       asp-for="@Model.Finca!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Código
                        </label>
                        <div class="col-6">
                            <input id="inCodigo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Finca!.Codigo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Nombre de la finca
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Finca!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Direccion de la finca
                        </label>
                        <div class="col-6">
                            <input id="inDirecccion"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Finca!.Direcccion" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Extension en metros de la finca
                        </label>
                        <div class="col-6">
                            <input id="inExtensionMetro"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Finca!.ExtensionMetro" />
                        </div>
                     </div>
                   

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Finca != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Finca?
                            </h6>
                            <h6 align="left">
                                @Model.Finca!.Codigo
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaFincas != null &&
                Model.ListaFincas.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Código
                        </th>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Direccion
                        </th>
                        
                        <th class="cl_hidden">
                            Extension metros 
                        </th>

                        <th class="cl_hidden">
                            Extension hectáreas
                        </th>

                        

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaFincas)
                    {
                        <tr>
                            <td>
                                @elemento.Codigo
                            </td>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.Direcccion
                            </td>
                            @* <td class="cl_hidden">
                                @elemento.Fecha.ToString("dd/MM/yyyy")
                            </td> *@
                            <td class="cl_hidden">
                                @elemento.ExtensionMetro
                            </td>

                            <td>
                                @elemento.ExtensionHectareas?.ToString("N2") ha 
                            </td>
                           

                            <td>
                                <div class="acciones">
                                    <button type="submit"
                                            asp-page-handler="BtModificar"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Modificar">

                                        <img src="~/imagenes/editable.png"
                                             class="action-icon" />
                                    </button>


                                    <button type="submit"
                                            asp-page-handler="BtBorrarVal"
                                            asp-route-data="@elemento.Id"
                                            class="icon-btn edit-btn"
                                            title="Borrar">

                                        <img src="~/imagenes/delete.png"
                                             class="action-icon" />
                                    </button>
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>