@page
@model VacunasModel
@{
    ViewData["Title"] = "Vacunas";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Vacunas</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Vacuna != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Vacuna == null)" />
            </div>

            @if (Model.Vacuna != null)
            {
                <input type="hidden"
                       asp-for="@Model.Vacuna!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Nombre de la vacuna
                        </label>
                        <div class="col-6">
                            <input id="inNombre"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Vacuna!.Nombre" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Costo de la vacuna
                        </label>
                        <div class="col-6">
                            <input id="inCostoVacuna"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Vacuna!.CostoVacuna" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Lote de la vacuna
                        </label>
                        <div class="col-6">
                            <input id="inLoteVacuna"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Vacuna!.LoteVacuna" />
                        </div>
                    </div>
                   
                     <div class="form-group">
                        <label>
                            Fecha de la compra 
                        </label>
                        <div class="col-6">
                            <input id="inFechaCompraVacuna"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Vacuna!.FechaCompraVacuna" />
                        </div>
                    </div>
                    

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Vacuna != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Vacuna?
                            </h6>
                            <h6 align="left">
                                @Model.Vacuna!.Nombre
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaVacunas != null &&
                Model.ListaVacunas.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Nombre
                        </th>
                        <th>
                            Costo de la vacuna
                        </th>
                        <th>
                            Lote de la vacuna
                        </th>
                         <th class="cl_hidden">
                            FechaCompraVacuna
                        </th> 
                        

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaVacunas)
                    {
                        <tr>
                            <td>
                                @elemento.Nombre
                            </td>
                            <td>
                                @elemento.CostoVacuna
                            </td>
                            <td>
                                @elemento.LoteVacuna
                            </td>
                            <td class="cl_hidden">
                                @elemento.FechaCompraVacuna.ToString("dd/MM/yyyy")
                            </td>
                           

                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>