@page
@model AnimalesModel
@{
    ViewData["Title"] = "Animales";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Animales</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Animal != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Animal == null)" />
            </div>

            @if (Model.Animal != null)
            {
                <input type="hidden"
                       asp-for="@Model.Animal!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Código
                        </label>
                        <div class="col-6">
                            <input id="inCodigo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Codigo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Peso inicial
                        </label>
                        <div class="col-6">
                            <input id="inPesoInicial"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.PesoInicial" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Raza
                        </label>
                        <div class="col-6">
                            <input id="inRaza"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Raza" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Edad
                        </label>
                        <div class="col-6">
                            <input id="inEdad"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Edad" />
                        </div>
                     </div>
                   @*  <div class="form-group">
                        <label>
                            Fecha
                        </label>
                        <div class="col-6">
                            <input id="inFecha"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Fecha" />
                        </div> 
                    </div> *@
                    <div class="form-group">
                        <label>
                            Sexo
                        </label>
                        <div class="col-6">
                            <input id="inSexo"
                                   asp-for="@Model.Animal!.Sexo" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            Lugar donde se encuentra el animal
                        </label>
                        <div class="col-6">
                            <input id="inLugarAnimalId"
                                   asp-for="@Model.Animal!.LugarAnimalId" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Lote donde se encuentra (Opcional)
                        </label>
                        <div class="col-6">
                            <input id="inLoteId"
                                   asp-for="@Model.Animal!.LoteId" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Id de la compra (opcional)
                        </label>
                        <div class="col-6">
                            <input id="inCompraId"
                                   asp-for="@Model.Animal!.CompraId" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Estado en el que se encuentra (1 en la finca, 2 vendido, 3 muerto)
                        </label>
                        <div class="col-6">
                            <input id="inEstadoId"
                                   asp-for="@Model.Animal!.EstadoId" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Id de la Venta (opcional)
                        </label>
                        <div class="col-6">
                            <input id="inVentaId"
                                   asp-for="@Model.Animal!.VentaId" />
                        </div>
                    </div>

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Animal != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Animal?
                            </h6>
                            <h6 align="left">
                                @Model.Animal!.Codigo
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaAnimales != null &&
                Model.ListaAnimales.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Código
                        </th>
                        <th>
                            Peso inicial
                        </th>
                        <th>
                            Raza
                        </th>
                        @* <th class="cl_hidden">
                            Fecha
                        </th> *@
                        <th class="cl_hidden">
                            Edad
                        </th>
                        <th class="cl_hidden">
                            Sexo
                        </th>
                         <th class="cl_hidden">
                            LoteId
                        </th>
                        <th class="cl_hidden">
                            CompraId
                        </th>
                        <th class="cl_hidden">
                            EstadoId
                        </th>
                        <th class="cl_hidden">
                            VentaId
                        </th>
                        <th class="cl_hidden">
                            LugarAnimalId
                        </th>

                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaAnimales)
                    {
                        <tr>
                            <td>
                                @elemento.Codigo
                            </td>
                            <td>
                                @elemento.PesoInicial
                            </td>
                            <td>
                                @elemento.Raza
                            </td>
                            @* <td class="cl_hidden">
                                @elemento.Fecha.ToString("dd/MM/yyyy")
                            </td> *@
                            <td class="cl_hidden">
                                @elemento.Edad
                            </td>
                            <td class="cl_hidden">
                                @elemento.Sexo
                            </td>
                            <td class="cl_hidden">
                                @elemento.LoteId
                            </td>
                            <td class="cl_hidden">
                                @elemento.CompraId
                            </td>
                            <td class="cl_hidden">
                                @elemento.EstadoId
                            </td>
                            <td class="cl_hidden">
                                @elemento.VentaId
                            </td>
                            <td class="cl_hidden">
                                @elemento.LugarAnimalId
                            </td>

                            <td>
                                <input type="submit"
                                       value="Modicar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit"
                                       value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>