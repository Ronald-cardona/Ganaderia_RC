@page
@model AnimalesModel
@{
    ViewData["Title"] = "Animales";
}

<center>
    <div>
        <form method="POST"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Animales</h3>
            </div>

            <div>
                <input type="submit"
                       value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                <input type="submit"
                       value="Nuevo"
                       class="btn btn-secondary"
                       asp-page-handler="BtNuevo"
                       disabled="@(Model.Animal != null)" />
                <input type="submit"
                       value="Guardar"
                       class="btn btn-secondary"
                       asp-page-handler="BtGuardar"
                       disabled="@(Model.Animal == null)" />
            </div>

            @if (Model.Animal != null)
            {
                <input type="hidden"
                       asp-for="@Model.Animal!.Id" />

                <div>
                    <div class="form-group">
                        <label>
                            Código
                        </label>
                        <div class="col-6">
                            <input id="inCodigo"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Codigo" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Peso inicial
                        </label>
                        <div class="col-6">
                            <input id="inPesoInicial"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.PesoInicial" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Raza
                        </label>
                        <div class="col-6">
                            <input id="inRaza"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Raza" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>
                            Edad
                        </label>
                        <div class="col-6">
                            <input id="inEdad"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.Edad" />
                        </div>
                     </div>
                  
                    <div class="form-group">
                        <label>
                            Sexo (Marcar para Hembra)
                        </label>
                        <div class="col-6">
                            <input id="inSexo"
                                   asp-for="@Model.Animal!.Sexo" />
                        </div>
                    </div>

                    @{
                        var correo = HttpContext.Session.GetString("Usuario");
                        var lugarAnimales = new presentacion_libreria.implementaciones.LugarAnimalesNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Lugar del animal
                        </label>

                        <div class="col-6">

                            <select asp-for="Animal.LugarAnimalId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un lugar
                                </option>

                                @foreach (var lugar in lugarAnimales)
                                {
                                    <option value="@lugar.Id">
                                        @lugar.Codigo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>

                        @{
                        
                            var lotes = new presentacion_libreria.implementaciones.LotesNegocio().Consultar(correo!);
                        }

                    <div class="form-group">
                        <label>
                            Lote del animal (Opcional)
                        </label>

                        <div class="col-6">

                            <select asp-for="Animal.LoteId"
                                    class="form-control">

                                <option value="">
                                    Seleccione un lote
                                </option>

                                @foreach (var lote in lotes)
                                {
                                    <option value="@lote.Id">
                                        @lote.Codigo
                                    </option>
                                }

                            </select>

                        </div>
                    </div>

                    @{
                        var compras = new presentacion_libreria.implementaciones.ComprasNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Descripción de la compra  (Opcional)
                        </label>

                        <div class="col-6">

                            <select asp-for="Animal.CompraId"
                                    class="form-control">

                                <option value="">
                                    Seleccione una descripción
                                </option>

                                @foreach (var compra in compras)
                                {
                                    <option value="@compra.Id">
                                        @compra.DescripcionCompra
                                    </option>
                                }

                            </select>

                        </div>
                    </div>


                    <div class="form-group">
                        <label>
                            Estado en el que se encuentra (1 en la finca, 2 vendido, 3 muerto)
                        </label>
                        <div class="col-6">
                            <input id="inEstadoId"
                                   class="cts_forms form-control"
                                   asp-for="@Model.Animal!.EstadoId" />
                        </div>
                    </div>


                    @{
                        var ventas = new presentacion_libreria.implementaciones.VentasNegocio().Consultar(correo!);
                    }

                    <div class="form-group">
                        <label>
                            Descripción de la venta  (Opcional)
                        </label>

                        <div class="col-6">

                            <select asp-for="Animal.VentaId"
                                    class="form-control">

                                <option value="">
                                    Seleccione una descripción
                                </option>

                                @foreach (var venta in ventas)
                                {
                                    <option value="@venta.Id">
                                        @venta.DescripcionVenta
                                    </option>
                                }

                            </select>

                        </div>
                    </div>

                    
                </div>
            }

            @if (ViewData.ContainsKey("Mensaje"))
            {
                @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
                ;
            }

            @if (Model.Animal != null && Model.Borrando)
            {
                <div class='popup'>
                    <div class='pp_ms_inner'>
                        <div style='width:95%'>
                            <h2 align="left">
                                Mensaje
                            </h2>

                            <h6 align="left">
                                Desea borrar el Animal?
                            </h6>
                            <h6 align="left">
                                @Model.Animal!.Codigo
                            </h6>

                            <input type="submit"
                                   value="Cerrar"
                                   asp-page-handler="BtCerrar"
                                   class="btn btn-secondary" />
                            <input type="submit"
                                   value="Borrar"
                                   asp-page-handler="BtBorrar"
                                   class="btn btn-secondary" />
                        </div>
                    </div>
                </div>
            }

            @if (Model != null &&
                Model.ListaAnimales != null &&
                Model.ListaAnimales.Count > 0)
            {
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>
                            Código
                        </th>
                        <th>
                            Peso inicial
                        </th>
                        <th>
                            Raza
                        </th>
                       
                        <th class="cl_hidden">
                            Edad
                        </th>
                        <th class="cl_hidden">
                            Sexo
                        </th>
                         <th class="cl_hidden">
                            Código del lote
                        </th>
                        <th class="cl_hidden">
                            Descripción compra
                        </th>
                        <th class="cl_hidden">
                            Estado del animal
                        </th>
                       @*  <th class="cl_hidden">
                            Descripción venta 
                        </th> *@
                        <th class="cl_hidden">
                            Lugar del animal
                        </th>

                        <th class="cl_hidden">
                            Ganancia 
                        </th>

                        <th class="cl_hidden">
                            Ganancia en porcentaje
                        </th>



                        <th class="cl_actions">
                            Acción
                        </th>
                    </tr>
                    @foreach (var elemento in Model.ListaAnimales)
                    {
                        <tr>
                            <td>
                                @elemento.Codigo
                            </td>
                            <td>
                                @elemento.PesoInicial.ToString("N2")Kg
                            </td>
                            <td>
                                @elemento.Raza
                            </td>
                            
                            <td class="cl_hidden">
                                @elemento.Edad
                            </td>
                            <td class="cl_hidden">
                                @(elemento.Sexo ? "Hembra" : "Macho") 
                            </td>
                            <td class="cl_hidden">
                                @elemento._lote?.Codigo
                            </td>
                            <td class="cl_hidden">
                                @elemento._compra?.DescripcionCompra
                            </td>
                            <td class="cl_hidden">
                                @elemento._estado?.Descripcion
                            </td>
                            <td class="cl_hidden">
                                @elemento._venta?.DescripcionVenta
                            </td>
                            <td class="cl_hidden">
                                @elemento._lugarAnimal?.Codigo
                            </td>

                            <td class="cl_hidden">
                                $@elemento.Ganancia?.ToString("N0")
                            </td>

                            <td class="cl_hidden">
                                @elemento.PorcentajeGanancia?.ToString("N2")%
                            </td>

                            <td>
                                <div class="acciones">
                                <button type="submit"
                                        asp-page-handler="BtModificar"
                                        asp-route-data="@elemento.Id"
                                        class="icon-btn edit-btn"
                                        title="Modificar">

                                    <img src="~/imagenes/editable.png"
                                         class="action-icon" />
                                </button>


                               <button type="submit"
                                        asp-page-handler="BtBorrarVal"
                                        asp-route-data="@elemento.Id"
                                        class="icon-btn edit-btn"
                                        title="Borrar">

                                    <img src="~/imagenes/delete.png"
                                         class="action-icon" />
                                </button>


                                <button type="submit"
                                        asp-page-handler="ReportePdf"
                                        asp-route-Id="@elemento.Id"
                                        class="icon-btn pdf-btn"
                                        title="Generar reporte PDF">

                                    <img src="~/imagenes/pdf.png"
                                         class="action-icon" />

                                </button>
                            
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>