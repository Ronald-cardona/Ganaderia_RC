@{
    var paginaActual =
         ViewContext.RouteData.Values["page"]?.ToString();

    var esLogin =
        paginaActual == "/Index";
}




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - presentacion_aspnetcore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/presentacion_aspnetcore.styles.css" asp-append-version="true" />
</head>
<body>

    @{

        var usuario = Context.Session.GetString("Usuario"); // para que no se muestre la pagina hasta que se inicie sesion 
        var rol = Context.Session.GetString("Rol"); // para filtrar por roles

    }

    <div class="layout">

          
                @if (!string.IsNullOrEmpty(usuario))
                @*  para que no se muestre la pagina hasta que se inicie sesion  *@
                {
                    <aside class="sidebar">

                        <div class="logo">

                            <img src="~/imagenes/logo.png"
                            class="logo-img" />
                            <h3> Ganadería RC</h3> 
                        </div>

                        <ul class="menu">


                            <li>

                                <button class="dropdown-btn">
                                    <img src="~/imagenes/house.png"
                                    class="menu-icon" />
                                    <span class="menu-text">
                                        Mi entorno ganadero
                                    </span>
                                </button>

                                <ul class="submenu">

                                    <li>
                                        <a asp-page="/ventanas/Fincas">
                                            Finca
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Personas">
                                            Personas en mi entorno
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/LugarAnimales">
                                            Potreros y Corrales
                                        </a>
                                    </li>

                                </ul>

                            </li>

                            <li>

                                <button class="dropdown-btn">
                                    <img src="~/imagenes/goat.png"
                                    class="menu-icon" />
                                    Gestión Animal
                                </button>

                                <ul class="submenu">

                                    <li>
                                        <a asp-page="/ventanas/Animales">
                                            Animales
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Lotes">
                                            Lotes de animales
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/HistorialPesos">
                                            Historial de pesos
                                        </a>
                                    </li>

                                </ul>

                            </li>

                            <li>

                                <button class="dropdown-btn">
                                    <img src="~/imagenes/injection.png"
                                    class="menu-icon" />
                                    Sanidad
                                </button>

                                <ul class="submenu">

                                    <li>
                                        <a asp-page="/ventanas/Vacunas">
                                            Vacunas
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/AplicacionVacunas">
                                            Aplicación vacunas
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/VisitasVeterinarias">
                                            Visitas veterinarias
                                        </a>
                                    </li>

                                </ul>

                            </li>

                            <li>

                                <button class="dropdown-btn">
                                    <img src="~/imagenes/wheat.png"
                                    class="menu-icon" />
                                    <span class="menu-text">
                                        Suplementacion y alimento
                                    </span>

                                </button>

                                <ul class="submenu">

                                    <li>
                                        <a asp-page="/ventanas/Alimentos">
                                            Alimentos
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/BrindarAlimentos">
                                            Alimentos brindados
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Suplementos">
                                            Suplementos
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/BrindarSuplementos">
                                            Suplementos brindados
                                        </a>
                                    </li>

                                </ul>

                            </li>

                            <li>

                                <button class="dropdown-btn">
                                    <img src="~/imagenes/deal.png"
                                    class="menu-icon" />
                                    <span class="menu-text">
                                        Socios del negocio
                                    </span>

                                </button>

                                <ul class="submenu">



                                    <li>
                                        <a asp-page="/ventanas/Clientes">
                                            Clientes
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Proveedores">
                                            Proveedores
                                        </a>
                                    </li>


                                </ul>

                            </li>


                            <li>

                                <button class="dropdown-btn">
                                    <img src="~/imagenes/currency.png"
                                    class="menu-icon" />
                                    Movimientos 
                                </button>

                                <ul class="submenu">

                                    <li>
                                        <a asp-page="/ventanas/Compras">
                                            Compras
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Ventas">
                                            Ventas
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Ingresos">
                                            Ingresos
                                        </a>
                                    </li>

                                    <li>
                                        <a asp-page="/ventanas/Gastos">
                                            Gastos
                                        </a>
                                    </li>

                                </ul>

                            </li>

                            @* SOLO ADMINISTRADOR *@
                            @if (rol == "Administrador")
                            {

                                <li>
                                    <a asp-page="/ventanas/Configuraciones"
                                    class="menu-btn">
                                        <img src="~/imagenes/setting.png"
                                        class="menu-icon" />
                                        Configuraciones
                                    </a>
                                </li>

                                <li>
                                    <a asp-page="/ventanas/Usuarios"
                                    class="menu-btn">
                                        <img src="~/imagenes/farmer.png"
                                        class="menu-icon" />
                                        Usuarios
                                    </a>
                                </li>


                                <li>
                                    <a asp-page="/ventanas/Roles"
                                    class="menu-btn">
                                        <img src="~/imagenes/shield.png"
                                        class="menu-icon" />
                                        Roles
                                    </a>
                                </li>

                            }
                            @*Hasta aca va el administrador *@

                        </ul>

                    </aside>

                }
            

        <!-- CONTENIDO -->
        <main class="main-content">
            @if (!esLogin)
            {

            <header class="navbar-custom">

                <div class="navbar-left">

                    <h4>
                        Sistema de Gestión Ganadera RC
                    </h4>

                </div>

                <div class="navbar-right">

                    <div class="user-box">

                        <img src="~/imagenes/farmer.png"
                             class="user-avatar" />

                        <div class="user-info">

                            <span class="user-label">
                                Usuario conectado
                            </span>

                            <span class="user-email">
                                @Context.Session.GetString("Usuario")
                            </span>

                        </div>

                    </div>

                    <form method="post"
                          asp-page="/Index"
                          asp-page-handler="BtClose">

                        <button type="submit"
                                class="logout-btn">
                               
                                <img src="~/imagenes/logout.png"
                                     class="logout-icon" />
                           Cerrar sesión

                        </button>

                    </form>

                </div>

            </header>
            }
            <section class="content">
                <div class="content-card">
                @RenderBody()
                </div>
            </section>

        </main>

    </div>

    <!-- Algo de java script que me ayudara a que el menu sea desplegable -->
    <script>

        const dropdowns =
        document.querySelectorAll(".dropdown-btn");

        dropdowns.forEach(button => {

        button.addEventListener("click", function () {

        const submenu =
        this.nextElementSibling;

        if(submenu.style.display === "block")
        {
        submenu.style.display = "none";
        }
        else
        {
        submenu.style.display = "block";
        }

        });

        });

    </script>


</body>
</html>
